panel.example.com {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8088 {
		# Behind Cloudflare, replace the example ranges below with all CIDRs from
		# https://www.cloudflare.com/ips/ (and set PORTOLAN_TRUSTED_PROXIES=cloudflare
		# in panel.env) so Caddy forwards client addresses instead of edge IPs.
		# trusted_proxies 198.51.100.0/24 2001:db8::/32
	}
	header Strict-Transport-Security "max-age=31536000"
}
