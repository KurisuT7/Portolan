[Unit]
Description=Portolan control panel
Documentation=https://github.com/KurisuT7/Portolan
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=portolan-panel
Group=portolan-panel
UMask=0077
Environment=PORTOLAN_DATABASE=/var/lib/portolan-panel/portolan.db
EnvironmentFile=/etc/portolan-panel/panel.env
ExecStart=/usr/local/lib/portolan-panel/portolan-panel
Restart=always
RestartSec=5s
StateDirectory=portolan-panel
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectHome=yes
ProtectSystem=strict
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
